PUSHOVER_TOKEN=your_pushover_token
PUSHOVER_USER=your_pushover_user_or_group_key
CALLMEBOT_PHONE=+393123456789
CALLMEBOT_APIKEY=your_callmebot_apikey

# Telegram Bot notifications (optional)
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Comma-separated list of authorized chat IDs (users or groups). See README for how to find them.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFICATIONS_ENABLED=true

# Gmail SMTP email notifications (optional)
# SMTP_PASSWORD must be a Gmail App Password, not your account password.
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated recipient list, sent via BCC.
EMAIL_RECIPIENTS=